{
  "name": "quran-arabic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A tool for learning and mastering Quranic Arabic: word-by-word grammar, tajweed, meaning, and context for every surah.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "fetch:data": "node scripts/fetch-raw.mjs",
    "build:data": "node scripts/build-data.mjs",
    "build:context": "node scripts/build-context.mjs && node scripts/build-context-summary.mjs",
    "build:vocab": "node scripts/build-vocab.mjs",
    "build:tajweed-guide": "node scripts/build-tajweed-guide.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/amiri-quran": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/scheherazade-new": "5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
